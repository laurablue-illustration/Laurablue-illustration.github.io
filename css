
*{
  box-sizing:border-box;
}

:root{
  --cream:#fdfbea;
  --olive:#707c28;
  --pink:#f5b5ac;
  --ink:#697126;
  --line:#d8d8c0;
  --white:#fff;
}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;
  background:var(--cream);
  color:var(--olive);
  font-family:"DM Sans",Arial,sans-serif;
  font-size:16px;
}

a{
  color:inherit;
  text-decoration:none;
}


/* =========================
   SECCIONES
========================= */

.shop-page,
.about-page,
.contact-page{
  border-top:1px solid rgba(112,124,40,.18);
}


/* =========================
   CABECERA
========================= */

.topbar{
  height:105px;
  display:grid;
  grid-template-columns:1fr auto 1fr;
  align-items:center;
  padding:0 clamp(28px,7.6vw,150px);
  position:sticky;
  top:0;
  z-index:20;
  background:rgba(253,251,234,.97);
}

.main-nav{
  display:flex;
  gap:44px;
  align-items:center;
}

.main-nav a{
  font-size:20px;
  font-weight:700;
  letter-spacing:.01em;
  transition:opacity .2s;
}

.main-nav a.active{
  color:var(--pink);
}

.main-nav a:hover{
  opacity:.55;
}

.brand{
  display:flex;
  align-items:center;
  justify-content:center;
  width:270px;
  height:120px;
}

.brand img{
  display:block;
  width:220px;
  height:auto;
  max-height:80px;
  object-fit:contain;
}


/* =========================
   PORTFOLIO
========================= */

.portfolio-page{
  max-width:1600px;
  margin:0 auto;
}

.hero-art{
  height:min(43vw,640px);
  min-height:430px;
  overflow:hidden;
}

.hero-art img{
  width:100%;
  height:100%;
  display:block;
  object-fit:cover;
  object-position:50% 40%;
}

.hero-placeholder{
  height:100%;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  background:linear-gradient(
    120deg,
    #f1d45d 0%,
    #f8c7a9 48%,
    #bd8a3b 100%
  );
  color:#fff9d9;
  text-align:center;
}

.hero-placeholder span{
  font-size:18px;
  font-weight:700;
  letter-spacing:.18em;
}

.hero-placeholder small{
  margin-top:12px;
  font-size:13px;
  letter-spacing:.04em;
}


/* =========================
   CATEGORÍAS
========================= */

.category-nav{
  display:flex;
  justify-content:center;
  gap:120px;
  padding:43px 20px 39px;
}

.category-nav a{
  font-size:20px;
  font-weight:700;
}

.category-nav a:hover{
  text-decoration:underline;
}

.category-button{
  cursor:pointer;
}

.category-button.active{
  color:var(--pink);
}


/* =========================
   GALERÍA
========================= */

.gallery{
  width:min(1300px,92vw);
  margin:0 auto;
  padding-bottom:100px;

  column-count:2;
  column-gap:18px;
}

.gallery-item{
  display:block;
  width:100%;
  margin:0 0 18px;

  break-inside:avoid;

  position:relative;
  overflow:hidden;

  cursor:pointer;

  opacity:0;
  transform:translateY(35px);

  transition:
    opacity .7s ease,
    transform .7s ease;
}

.gallery-item.is-visible{
  opacity:1;
  transform:translateY(0);
}

.gallery-item img{
  width:100%;
  height:auto;
  display:block;
  object-fit:contain;

  transition:transform .35s ease;
}

.gallery-item:hover img{
  transform:scale(1.015);
}


/* =========================
   CAPA BLANCA Y TÍTULO
   SOLO EDITORIAL Y CARTELES
========================= */

.category-editorial::before,
.category-carteles::before {
  content: attr(data-title);

  position: absolute !important;
  top: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  left: 0 !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  box-sizing: border-box !important;
  padding: 25px !important;

  background: rgba(255, 255, 255, 0.75) !important;

  color: #707c28 !important;

  font-family: "DM Sans", Arial, sans-serif !important;
  font-size: 20px !important;
  font-weight: 600 !important;
  line-height: 1.4 !important;

  text-align: center !important;
  white-space: pre-line !important;

  opacity: 0 !important;

  z-index: 10 !important;

  pointer-events: none !important;

  transition: opacity .25s ease !important;
}

.category-editorial:hover::before,
.category-carteles:hover::before {
  opacity: 1 !important;
}

/* Título */

.category-editorial::before,
.category-carteles::before{
  content:attr(data-title);

  position:absolute;

  top:50%;
  left:50%;

  transform:translate(-50%,-50%);

  width:80%;

  color:#707c28;

  font-family:"DM Sans",Arial,sans-serif;
  font-size:20px;
  font-weight:600;

  text-align:center;

  /*
    Permite que los saltos de línea
    escritos en data-title se respeten.
  */
  white-space:pre-line;

  opacity:0;

  pointer-events:none;

  z-index:3;

  transition:opacity .25s ease;
}


/* Mostrar al pasar el cursor */

.category-editorial:hover::after,
.category-carteles:hover::after,
.category-editorial:hover::before,
.category-carteles:hover::before{
  opacity:1;
}


/* =========================
   PLACEHOLDERS
========================= */

.art-placeholder{
  min-height:310px;
  width:100%;

  display:flex;
  align-items:center;
  justify-content:center;

  color:rgba(65,65,30,.55);
  font-weight:700;
  letter-spacing:.12em;

  transition:
    transform .3s ease,
    filter .3s ease;
}

.art-placeholder:hover{
  transform:scale(1.015);
  filter:saturate(1.08);
}

.item-large .art-placeholder{
  min-height:560px;
}

.yellow{
  background:linear-gradient(
    145deg,
    #ead151,
    #f4e68d
  );
}

.landscape{
